# ITMC FenestrationOS backend configuration (copy to .env; NEVER commit real secrets)
# dev | test | prod   (prod: JWT_SECRET required, HSTS on, demo password required if demo users seeded)
ENV=dev
DATABASE_URL=postgresql+psycopg://fos:CHANGE_ME@localhost:5432/fos
# >= 32 random chars, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MIN=480
# comma separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# seeding (idempotent): catalogue revision is always ensured; demo users/data only when enabled
SEED_ON_STARTUP=1
SEED_DEMO_USERS=0
# SEED_DEMO_DATA defaults to SEED_DEMO_USERS
#SEED_DEMO_DATA=0
DEMO_PASSWORD=
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_S=300
MAX_UPLOAD_MB=5
# public URL of the web app (QR labels encode {PUBLIC_BASE_URL}/p/{part code}); no trailing slash
PUBLIC_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=1
# serve ../frontend/dist at / when present (single-container mode)
SERVE_FRONTEND=1
#FRONTEND_DIST=/app/frontend_dist
